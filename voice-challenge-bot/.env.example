# ===================================================================
# voice-challenge-bot 環境変数サンプル
# 実際の値を入れたコピーを ".env" として保存してください（.env は git 管理外）
# ===================================================================

# -------- 既存：voice-challenge-bot 本体 --------
DISCORD_BOT_TOKEN=
GUILD_ID=
INTRO_CHANNEL_ID=
DIARY_CHANNEL_ID=
ENJOY_CHANNEL_ID=
GACHI_CHANNEL_ID=
NEWS_CHANNEL_ID=
GEMINI_API_KEY=
TZ=Asia/Tokyo

# -------- 既存：アンケート --------
SURVEY_CHANNEL_ID=
SURVEY_LOG_CHANNEL_ID=
SURVEY_SHEET_URL=

# -------- 既存：動画生成 --------
VOICE_PRACTICE_CHANNEL_ID=
PRIVATE_CHANNEL_ID=
ALLOWED_VIDEO_USERS=

# -------- 既存：声劇イベント --------
VOICE_DRAMA_CHANNEL_ID=
VOICE_DRAMA_ARCHIVE_CHANNEL_ID=
VOICE_DRAMA_STAGE_CHANNEL_ID=

# ===================================================================
# VoiPoke 連携（新規）
# 共通設定 spec：/Users/hidehisa/VoiPoke/spec/discord-shared-config.md
# Bot 側 spec ：/Users/hidehisa/Discord練習会/voice-challenge-bot/spec/voipoke-integration.md
# ===================================================================

# Webhook サーバー
# VOIPOKE_WEBHOOK_SECRET を空にすれば Webhook サーバーは起動しない（既存運用に影響なし）
VOIPOKE_WEBHOOK_PORT=3000
VOIPOKE_WEBHOOK_SECRET=

# ぼいラボ Discord サーバー
VOIPOKE_GUILD_ID=

# VoiPoke 連携ロール ID（4個）
VOIPOKE_ROLE_PREMIUM_LISTENER=
VOIPOKE_ROLE_CREATORS_PRO=
VOIPOKE_ROLE_MASTER=
VOIPOKE_ROLE_CREATOR=

# 新作通知チャンネル ID
VOIPOKE_NEW_CHANNEL_ID=
VOIPOKE_NEW_SITUATION_CHANNEL_ID=
VOIPOKE_NEW_ASMR_CHANNEL_ID=

# マスター限定チャンネル ID
MASTER_LOUNGE_CHANNEL_ID=
MASTER_EVENT_CHANNEL_ID=

# VoiPoke Supabase（マスターイベント機能で使用）
VOIPOKE_SUPABASE_URL=

# ===================================================================
# Reverb ニュース（新規）
# 開発ツール（VoiPoke / VoiLog / ぼいラボ / ぼいフォリオ / キャラビジュ）の
# アップデート通知と、ペルソナ活用事例の自動配信を担当。
#
# しくみ：
#   1. 各ツールが webhook を叩く（POST /reverb/update）→ 即配信
#   2. 毎晩21時、当日の webhook 件数が0なら → AIがペルソナ活用事例を生成して配信
#
# REVERB_WEBHOOK_SECRET を空にすれば webhook エンドポイントは無効になる
# （既存運用には影響しない）
# ===================================================================

# Reverb ニュース配信先チャンネル
REVERB_NEWS_CHANNEL_ID=

# 通知ロール（opt-in／🔔リアクションで自動付与）
REVERB_NOTIFY_ROLE_ID=

# webhook 認証用シークレット（VoiPokeとは別に管理）
REVERB_WEBHOOK_SECRET=

# ===================================================================
# クリエイター集客（F1 MVP）
# ぼいラボの「クリエイター」（ASMR・シチュボ・楽曲・脚本など）を招待し、
# 毎月1日10時にお題テーマEmbedを自動投稿する。
#
# ⚠️ ロール分離：
#   - VOIPOKE_ROLE_CREATOR ... VoiPoke 連携専用（既存）
#   - CREATOR_ROLL_ID      ... ぼいラボ集客用（新規・F1 招待ボタンが付与するロール）
#
# 設定が空のときは月次お題投稿はスキップされる（既存運用に影響なし）。
# ===================================================================
CREATOR_CHANNEL_ID=
CREATOR_ROLL_ID=

# ===================================================================
# アーリーアクセス（Reverb Lab 早期メンバー）
# 一括付与コマンド `!grant_early_role_all` 実行で全既存メンバーに付与し、
# 以降の新規参加者は GuildMemberAdd イベントで自動付与される。
# VoiPoke ローンチ時、このロール保持者に「クリエイター有料プラン3ヶ月無料」訴求予定。
#
# ⚠️ Discord Developer Portal 側で SERVER MEMBERS INTENT の有効化が必要。
# 設定が空のときは自動付与は無効（一括付与コマンドもエラー）。
# ===================================================================
EARLY_ACCESS_ROLE_ID=

# ===================================================================
# ぼいフォリオ ログインボーナス連携（Phase B）
# 今日初投稿のユーザーに ガチャチケット 1枚 を付与する仕組み。
# bot → ぼいフォリオへ HMAC 認証付き webhook で通知する。
#
# - VOILAB_BACKEND_URL    : ぼいフォリオ本番URL（末尾スラッシュ無し）
# - VOILAB_BACKEND_SECRET : 受信側（voilab-lp / 声優のため）と同じシークレット
#
# どちらか空のときはログインボーナス機能は無効になる（既存挙動に影響なし）。
# ===================================================================
VOILAB_BACKEND_URL=https://voifolio.reverb-lab.com
VOILAB_BACKEND_SECRET=

# ===================================================================
# M-5: ぼいラボ Discord 自動招待化（LP → OAuth → 入室の自動フロー）
#
# - LP（voilab-lp / voipoke-lp / 診断結果）からの入室を経路別に追跡
# - 経路に応じて初期ロールを付与し、ウェルカム DM を送信
# - 毎週月曜 9:00 に #運営ログ へ週次レポート自動投稿
#
# Discord Developer Portal で「ぼいラボ招待 Bot」を新規作成し、
# OAuth2 スコープ identify + guilds.join を有効化したうえで取得する。
# 仕様参照: /Users/hidehisa/【監督】/specs/M-5-community-design-2026-05-07.md
# ===================================================================

# Discord OAuth アプリ情報
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_BOT_TOKEN_INVITE=        # guilds.join 専用 Bot のトークン（既存とは別）
DISCORD_OAUTH_REDIRECT_URI=https://ykmerwuwehgjdyfhpeiy.supabase.co/functions/v1/discord-oauth-callback

# M-5 自動招待ロール
DISCORD_ROLE_VOISEIYU_KIBOU=     # 声優志望ロール ID
DISCORD_ROLE_VOICEUSER=          # 声活ユーザーロール ID
DISCORD_ROLE_PRE_VOIPOKE=        # VoiPoke 先行登録済ロール ID
DISCORD_ROLE_DIAGNOSED=          # 診断完了ロール ID

# 診断タイプ別サブロール（10 色）
DISCORD_ROLE_TYPE_KOGANE=        # 黄金タイプ
DISCORD_ROLE_TYPE_TOKIWA=        # 常磐タイプ
DISCORD_ROLE_TYPE_MIZU=          # 水タイプ
DISCORD_ROLE_TYPE_BOTAN=         # 牡丹タイプ
DISCORD_ROLE_TYPE_TSUTSUJI=      # 躑躅タイプ
DISCORD_ROLE_TYPE_SUMIRE=        # 菫タイプ
DISCORD_ROLE_TYPE_ENJI=          # 臙脂タイプ
DISCORD_ROLE_TYPE_ASAGI=         # 浅葱タイプ
DISCORD_ROLE_TYPE_URUMI=         # 潤みタイプ
DISCORD_ROLE_TYPE_GINCHA=        # 銀茶タイプ

# M-5 チャンネル（診断結果ルームは作らない方針 → ロールだけで識別）
VOIPOKE_EARLY_MEMBER_CHANNEL_ID= # #voipoke-先行メンバー
OPS_LOG_CHANNEL_ID=              # #運営ログ（非公開）

# Supabase 連携（週次レポート用 / discord_invitations 集計）
# 既存の SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY を流用してOK
